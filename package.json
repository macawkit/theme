{
  "name": "@macawkit/theme",
  "version": "0.3.3",
  "description": "A small CSS kit for MacawKit projects",
  "exports": {
    "./general": "./dist/general.js",
    "./package.json": "./package.json",
    "./*": "./dist/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
