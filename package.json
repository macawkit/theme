    "prepack": "npm run build:release"
  },
  "author": {
    "name": "Yury Gubich",
    "email": "blue@macaw.me"
  },
  "repository": {
    "url": "git+https://github.com/macawkit/theme.git",
    "type": "git"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
